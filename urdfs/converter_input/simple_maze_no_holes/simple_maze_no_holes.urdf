<?xml version="1.0" encoding="UTF-8"?>
<robot name="Labyrinth">
  <link name="Support">
    <visual>
      <origin xyz="0. 0. 0." rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/Support.STL" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="Red">
          <color rgba="1.0 0.0 0.0 1.0"/> <!-- RGB + Alpha (transparency) -->
      </material>
    </visual>
  
  </link>  

  <link name="OuterDOF">
    <visual>
      <origin xyz="0.0 0.0 -0.1" rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/OuterDOF.STL" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link> 

  <link name="InnerDOF">
    <visual>
      <origin xyz="0.0 0.0 -0.1" rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/InnerDOF.STL" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>  
  </link>

  <link name="InnerDOFCollisions">
   <collision>
      <origin xyz="0.0 0.0 -0.005" rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/InnerDOF_base-1.STL" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="0.0 0.0 -0.005" rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/InnerDOF_long_wall-1.STL" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    
    <collision>
      <origin xyz="0.0 0.0 -0.005" rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/InnerDOF_long_wall-2.STL" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="0.0 0.0 -0.005" rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/InnerDOF_short_wall-1.STL" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="0.0 0.0 -0.005" rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/InnerDOF_short_wall-2.STL" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision> 
  </link>

  <link name="InnerDOFWalls">
    <visual>
      <origin xyz="0.0 0.0 -0.1" rpy="1.57 0. 0. "/>
      <geometry>
        <mesh filename="meshes/InnerDOFWalls.STL" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="Black">
          <color rgba="0.0 0.0 0.0 1.0"/> <!-- RGB + Alpha (transparency) -->
      </material>
    </visual>
  </link> 

  <joint name="InnerDOF_RevoluteJoint" type="continuous">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0. 0."/>
    <parent link="OuterDOF"/>
    <child link="InnerDOF"/>
    <axis xyz="0. 1. 0."/>
    <limit lower="-0.26179" upper="0.26179" effort="100.0" velocity="100.0"/>
  </joint>

  <joint name="OuterDOF_RevoluteJoint" type="continuous">
    <origin xyz="0.0 0.0 0.1" rpy="0. 0. 0."/>
    <parent link="Support"/>
    <child link="OuterDOF"/>
    <axis xyz="1. 0. 0."/>
    <limit lower="-0.26179" upper="0.26179" effort="100.0" velocity="100.0"/>
  </joint>

  <joint name="FixedMazeWallJoint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0. 0. 0."/>
    <parent link="InnerDOF"/>
    <child link="InnerDOFWalls"/>
  </joint>
  <joint name="FixedMazeCollisionsJoint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0. 0. 0."/>
    <parent link="InnerDOF"/>
    <child link="InnerDOFCollisions"/>
  </joint>
